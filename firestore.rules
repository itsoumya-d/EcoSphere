rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
      
      // User's challenge progress subcollection
      match /challengeProgress/{progressId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
      
      // User's inventory subcollection
      match /inventory/{itemId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }
    
    // Activities collection
    match /activities/{activityId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // Challenges collection
    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false; // Only admin via backend
    }
    
    // Rewards collection
    match /rewards/{rewardId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false; // Only admin via backend
    }
    
    // Badges collection
    match /badges/{badgeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false; // Only admin via backend
    }
    
    // Posts collection (Social Feed)
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }
    
    // Articles collection (Education content)
    match /articles/{articleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false; // Only admin via backend
    }
    
    // Resources collection (Maps/Local services)
    match /resources/{resourceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn(); // Users can submit resources
      allow update, delete: if false; // Only admin via backend
    }
  }
}
